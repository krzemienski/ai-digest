# AI / LLM
ANTHROPIC_API_KEY=  # Required: Anthropic API key for Claude models

# Audio / TTS
ELEVENLABS_API_KEY=  # Required: ElevenLabs API key for podcast TTS

# Email / Newsletter
RESEND_API_KEY=  # Required: Resend API key for email delivery
RESEND_AUDIENCE_ID=  # Required: Resend audience/contact list ID
EMAIL_FROM=  # Optional: Newsletter sender email (e.g., newsletter@example.com)
UNSUBSCRIBE_URL=  # Optional: Unsubscribe URL base (e.g., https://example.com/unsubscribe)
UNSUBSCRIBE_SECRET=  # Optional: Secret for signing unsubscribe links

# Database
DATABASE_URL=postgresql://localhost:5432/ai_digest_dev  # PostgreSQL connection string

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379  # Redis connection string for job queue

# Admin Auth
ADMIN_API_KEY=  # Required: Admin API key for protected endpoints

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=  # Required: Supabase project URL (e.g., https://xxx.supabase.co)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=  # Required: Supabase publishable key (sb_publishable_...)

# Security / Encryption
API_KEY_ENCRYPTION_SECRET=  # Required: 32-byte hex string. Generate with: openssl rand -hex 32

# Cloudflare R2 (Object Storage)
R2_ACCESS_KEY_ID=  # Cloudflare R2 access key
R2_SECRET_ACCESS_KEY=  # Cloudflare R2 secret key
R2_BUCKET_NAME=  # R2 bucket name
R2_ENDPOINT=  # R2 endpoint URL (e.g., https://account.r2.cloudflarestorage.com)
R2_PUBLIC_URL=  # R2 public URL for accessing files

# AWS S3 (Audio Storage - Alternative to R2)
S3_ACCESS_KEY_ID=  # Optional: AWS access key for S3
S3_SECRET_ACCESS_KEY=  # Optional: AWS secret key for S3
S3_BUCKET_NAME=  # Optional: S3 bucket name for audio files
S3_REGION=  # Optional: S3 region (e.g., us-east-1)
S3_PUBLIC_URL=  # Optional: S3 public URL base

# Source Tokens
GITHUB_TOKEN=  # Optional: GitHub PAT for enhanced API rate limits
PRODUCTHUNT_TOKEN=  # Optional: ProductHunt API token

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL=  # Optional: Upstash Redis REST URL for rate limiting
UPSTASH_REDIS_REST_TOKEN=  # Optional: Upstash Redis REST token
